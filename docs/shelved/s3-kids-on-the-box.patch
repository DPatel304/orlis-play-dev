+  const n = (typeof v === 'string' ? v : '').trim().replace(/\s+/g, ' ');
+  if (n.length < LIMITS.name[0] || n.length > LIMITS.name[1]) throw fail(`Names are ${LIMITS.name[0]} to ${LIMITS.name[1]} letters.`, 'bad_name');
+  if (/@|\d{5,}|https?:/i.test(n)) throw fail('Just a first name or nickname, please.', 'bad_name');
+  return n;
+}
+export function cleanAvatar(v){
+  const a = (typeof v === 'string' ? v.trim() : '') || AVATAR_IDS[0];
+  if (!AVATAR_IDS.includes(a)) throw fail('Pick one of the avatars.', 'bad_avatar');
+  return a;
+}
+/* an avatar's look is the maker's own data: a plain object (or none), kept small */
+function cleanLook(v){
+  if (v == null) return null;
+  if (typeof v !== 'object' || Array.isArray(v)) throw fail('That avatar didn’t look right.', 'bad_look');
+  let t; try { t = JSON.stringify(v); } catch { t = null; }
+  if (!t || t.length > 4000) throw fail('That avatar didn’t look right.', 'bad_look');
+  return JSON.parse(t);
+}
+const cleanId = (v) => (typeof v === 'string' && /^[\w-]{1,64}$/.test(v) ? v : null);
+const newKidId = () => (globalThis.crypto && crypto.randomUUID ? crypto.randomUUID().replace(/-/g, '').slice(0, 18) : Math.random().toString(16).slice(2, 11) + Date.now().toString(16));
+const keep = (k) => ({ id: k.id, name: k.name, avatar: k.avatar, look: k.look ?? null, createdAt: k.createdAt });
+
+/* The family's kids. storage: localStorage (or anything with getItem/setItem).
+   householdId names the family's key (orlis.kids.<householdId>); grownups()
+   says how many grown-ups there are, because 8 profiles is the family's limit
+   and they count too. */
+export function createKids(storage = (typeof localStorage !== 'undefined' ? localStorage : null), { householdId = '', grownups = () => 1 } = {}){
+  const KEY = `orlis.kids.${householdId}`;
+  const read = () => {
+    try {
+      const v = JSON.parse(storage.getItem(KEY));
+      return v && Array.isArray(v.kids) ? v.kids.filter(k => k && cleanId(k.id)).map(keep) : [];
+    } catch { return []; }
+  };
+  /* false if it couldn't be kept (the caller must not count it as copied) */
+  const write = (kids) => { try { storage.setItem(KEY, JSON.stringify({ v: FILE_V, kids })); return true; } catch { return false; } };
+  const room = (kids) => kids.length + Math.max(0, grownups()) < LIMITS.profiles;
+  const must = (kids) => { if (!write(kids)) throw fail('That didn’t save on this PC. Try again.', 'not_saved'); };
+
+  const api = {
+    grownups: () => grownups(),
+    list(){ return read().map((k, i) => [k, i]).sort((a, b) => (a[0].createdAt || 0) - (b[0].createdAt || 0) || a[1] - b[1]).map(x => x[0]); },
+    add({ name, avatar, look } = {}){
+      const kids = read();
+      if (!room(kids)) throw fail(`A family can have up to ${LIMITS.profiles} profiles.`, 'full');
+      const k = { id: newKidId(), name: cleanName(name), avatar: cleanAvatar(avatar), look: cleanLook(look), createdAt: Date.now() };
+      must([...kids, k]);
+      return { ...k };
+    },
+    update(id, patch = {}){
+      const kids = read(), i = kids.findIndex(k => k.id === id);
+      if (i < 0) throw fail('No such profile.', 'no_profile');
+      const k = { ...kids[i] };
+      if (patch.name !== undefined) k.name = cleanName(patch.name);
+      if (patch.avatar !== undefined) k.avatar = cleanAvatar(patch.avatar);
+      if (patch.look !== undefined) k.look = cleanLook(patch.look);
+      kids[i] = k; must(kids);
+      return { ...k };
+    },
+    remove(id){
+      const kids = read();
+      if (!kids.some(k => k.id === id)) throw fail('No such profile.', 'no_profile');
+      must(kids.filter(k => k.id !== id));
+    },
+    /* the server's kids (their ids kept, so seats, trusted phones and saved state still match); the ones already here stay as they are.
+       Returns the ids that are safely kept here now (read back, not just written). */
+    importFromServer(profiles = []){
+      const kids = read(), have = new Set(kids.map(k => k.id));
+      const add = [];
+      for (const p of profiles){
+        const id = p && cleanId(p.id); if (!id || have.has(id)) continue;
+        let k; try { k = { id, name: cleanName(p.name), avatar: cleanAvatar(p.avatar), look: cleanLook(p.look), createdAt: Number(p.createdAt) || Date.parse(p.createdAt) || Date.now() }; } catch { continue; }
+        have.add(id); add.push(k);
+      }
+      if (add.length) write([...kids, ...add]);
+      const now = new Set(read().map(k => k.id));
+      return profiles.map(p => p && p.id).filter(id => now.has(id));
+    },
+    /* a backup the parent can keep: { v: 1, kids: [...] } */
+    exportFile(){ return JSON.stringify({ v: FILE_V, kids: api.list() }, null, 2); },
+    /* a backup read back: the kids not here yet are added, with their own ids. { added, skipped } */
+    importFile(text){
+      let f; try { f = JSON.parse(text); } catch { f = null; }
+      if (!f || f.v !== FILE_V || !Array.isArray(f.kids)) throw fail('That isn’t an Orlis backup file.', 'bad_file');
+      const kids = read(), have = new Set(kids.map(k => k.id));
+      let added = 0, skipped = 0;
+      for (const p of f.kids){
+        const id = p && cleanId(p.id);
+        let k = null; try { k = id && { id, name: cleanName(p.name), avatar: cleanAvatar(p.avatar), look: cleanLook(p.look), createdAt: Number(p.createdAt) || Date.now() }; } catch { k = null; }
+        if (k && have.has(id)) continue;                   /* already here */
+        if (!k || !room(kids)){ skipped++; continue; }
+        kids.push(k); have.add(id); added++;
+      }
+      if (added) must(kids);
+      return { added, skipped };
+    }
+  };
+  return api;
+}
+
+/* The server's list as a grown-up's own profile (the first on each account)
+   and children (everyone else): the server's list is in the order they were made. */
+export function splitProfiles(list = []){
+  const seen = new Set(), grownups = [], kids = [];
+  for (const p of list){
+    if (!p || p.kid) continue;
+    if (!seen.has(p.accountId)){ seen.add(p.accountId); grownups.push(p); } else kids.push(p);
+  }
+  return { grownups, kids };
+}
+/* who's playing: the grown-ups from the server, then the kids from the Box */
+export const mergeProfiles = (grownups, kids) => [...grownups, ...kids.map(k => ({ ...k, kid: true }))];
+
+/* The one-time move, step 1: copy the server's kids into the Box. Returns the
+   grown-ups, and the ids the server may now delete (only ones read back from the Box). */
+export function copyToBox(kids, serverProfiles){
+  const { grownups, kids: theirs } = splitProfiles(serverProfiles);
+  return { grownups, ids: theirs.length ? kids.importFromServer(theirs) : [] };
+}
+/* step 2: tell the server, which deletes them. True once it has answered. */
+export async function confirmMove(ids, post){
+  if (!ids.length) return true;
+  try { const r = await post(ids); return !!r && Array.isArray(r.ids); } catch { return false; }
+}
+
+/* Only Orlis Play (the Windows app) is a Box: it alone takes the kids from the
+   server and keeps their backups as files. A browser, or the dev server, never
+   moves anyone - it shows the server's kids as they are, read-only. */
+export const isBoxApp = () => typeof window !== 'undefined' && !!window.__TAURI_INTERNALS__;
+const invoke = (cmd, args) => window.__TAURI_INTERNALS__.invoke(cmd, args);
+
+/* A backup to the parent. In Orlis Play: a file in Documents\Orlis Play\Backups. In a browser: a download.
+   Returns what to tell them. */
+export async function saveBackup(text, name = `orlis-kids-${new Date().toISOString().slice(0, 10)}.json`){
+  if (isBoxApp()){
+    await invoke('kids_backup', { text });
+    return 'Saved to Documents \u203a Orlis Play \u203a Backups';
+  }
+  const a = document.createElement('a');
+  a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' })); a.download = name;
+  document.body.appendChild(a); a.click(); a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+  return 'Saved';
+}
+
+/* The quiet safety copy, after every change (Orlis Play only; the newest 10 files are kept). Never throws. */
+export async function autoBackup(kids){
+  if (!isBoxApp()) return false;
+  try { await invoke('kids_backup', { text: kids.exportFile() }); return true; } catch { return false; }
+}
+
+/* On start: this family's Box store is empty, but a backup file is there. Returns { text, count } to offer, or null. */
+export async function restoreOffer(kids, latest = () => invoke('kids_backup_latest')){
+  if (!isBoxApp() || kids.list().length) return null;
+  let text; try { text = await latest(); } catch { return null; }
+  if (!text) return null;
+  let f; try { f = JSON.parse(text); } catch { return null; }
+  if (!f || f.v !== FILE_V || !Array.isArray(f.kids)) return null;
+  /* what it would bring back (a dry run in a scratch store) */
+  const tmp = new Map();
+  const probe = createKids({ getItem: (k) => (tmp.has(k) ? tmp.get(k) : null), setItem: (k, v) => tmp.set(k, v) }, { householdId: 'probe', grownups: kids.grownups });
+  let count = 0; try { count = probe.importFile(text).added; } catch { return null; }
+  return count ? { text, count } : null;
+}
