+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createKids, cleanName, splitProfiles, mergeProfiles, copyToBox, confirmMove, LIMITS, AVATAR_IDS } from '../src/ui/kids.js';
+import { account, AVATARS } from '../src/ui/account.js';
+
+/* a storage like localStorage's (which can be told to fail) */
+const mem = () => { const m = new Map(); return { getItem: (k) => (m.has(k) ? m.get(k) : null), setItem(k, v){ if (this.broken) throw new Error('full'); m.set(k, String(v)); }, removeItem: (k) => m.delete(k), m }; };
+const fresh = (opts = {}) => { const st = mem(); return { st, kids: createKids(st, { householdId: 'h1', ...opts }) }; };
+
+test('the avatar ids are the account screen\'s', () => {
+  assert.deepEqual(AVATAR_IDS, Object.keys(AVATARS));
+});
+
+test('add, update, remove: a kid has an id, a name, a picture, an avatar and a date', () => {
+  const { kids, st } = fresh();
+  const a = kids.add({ name: '  Ollie  ', avatar: 'dino' });
+  assert.match(a.id, /^[\w-]{8,}$/);
+  assert.equal(a.name, 'Ollie'); assert.equal(a.avatar, 'dino'); assert.equal(a.look, null); assert.ok(a.createdAt > 0);
+  assert.ok(st.m.has('orlis.kids.h1'), 'kept under the family\'s key');
+  const look = { colour: 'pink', top: 'bob' };
+  assert.deepEqual(kids.update(a.id, { name: 'Olly', look }).look, look);
+  assert.equal(kids.update(a.id, { avatar: 'owl' }).name, 'Olly', 'a part at a time');
+  assert.deepEqual(kids.list().map(k => k.name), ['Olly']);
+  assert.throws(() => kids.update('nope', { name: 'X' }), { code: 'no_profile' });
+  kids.remove(a.id);
+  assert.deepEqual(kids.list(), []);
+  assert.throws(() => kids.remove(a.id), { code: 'no_profile' });
+  /* kept across a reload */
+  const b = kids.add({ name: 'Mia' });
+  assert.equal(createKids(st, { householdId: 'h1' }).list()[0].id, b.id);
+  assert.deepEqual(createKids(st, { householdId: 'h2' }).list(), [], 'another family\'s are not these');
+});
+
+test('the same name rules as the server: a first name or nickname', () => {
+  const { kids } = fresh();
+  for (const bad of ['kid@example.com', '07700 900123', 'https://x.y', '', '   ', 'x'.repeat(21)]){
+    assert.throws(() => kids.add({ name: bad }), { code: 'bad_name' }, JSON.stringify(bad));
+  }
+  assert.equal(cleanName('Anna  Lee'), 'Anna Lee');
+  assert.throws(() => kids.add({ name: 'Ok', avatar: 'nope' }), { code: 'bad_avatar' });
+  assert.throws(() => kids.add({ name: 'Ok', look: [1] }), { code: 'bad_look' });
+  assert.throws(() => kids.update('x', { name: '' }));
+  assert.deepEqual(kids.list(), [], 'nothing kept from a refused one');
+});
+
+test('8 profiles to a family, the grown-ups counting too', () => {
+  const { kids } = fresh({ grownups: () => 2 });
+  for (let i = 0; i < LIMITS.profiles - 2; i++) kids.add({ name: `Kid ${String.fromCharCode(65 + i)}` });
+  assert.throws(() => kids.add({ name: 'One more' }), { code: 'full' });
+  assert.equal(kids.list().length, 6);
+});
+
+test('a save that does not stick is an error, never a quiet loss', () => {
+  const { kids, st } = fresh();
+  st.broken = true;
+  assert.throws(() => kids.add({ name: 'Ollie' }), { code: 'not_saved' });
+  assert.deepEqual(kids.list(), []);
+});
+
+const server = (...rows) => rows.map(([id, name, accountId, createdAt = '2026-01-01T00:00:00.000Z']) => ({ id, name, avatar: 'cat', look: null, accountId, createdAt }));
+
+test('importFromServer keeps ids, is idempotent, and leaves what is here alone', () => {
+  const { kids } = fresh();
+  const mine = kids.add({ name: 'Local' });
+  const rows = server(['p1', 'Ellie', 'A'], ['p2', 'Ravi', 'A', '2026-02-01T00:00:00.000Z']);
+  assert.deepEqual(kids.importFromServer(rows), ['p1', 'p2'], 'the ids now kept');
+  assert.deepEqual(kids.importFromServer(rows), ['p1', 'p2'], 'again: still the same');
+  assert.deepEqual(kids.list().map(k => k.id).sort(), ['p1', 'p2', mine.id].sort(), 'once each');
+  kids.update('p1', { name: 'Elle' });
+  kids.importFromServer(rows);
+  assert.equal(kids.list().find(k => k.id === 'p1').name, 'Elle', 'a change made here is not undone');
+  assert.deepEqual(kids.importFromServer([{ id: 'p9', name: 'bad@name', avatar: 'cat' }, null]), [], 'a bad one is not counted as copied');
+});
+
+test('what could not be kept is not reported as copied', () => {
+  const { kids, st } = fresh();
+  st.broken = true;
+  assert.deepEqual(kids.importFromServer(server(['p1', 'Ellie', 'A'])), []);
+});
+
+test('export, then import: the same kids come back, with their ids', () => {
+  const a = fresh(), b = fresh();
+  const x = a.kids.add({ name: 'Ollie', avatar: 'fish', look: { colour: 'pink' } });
+  a.kids.add({ name: 'Mia' });
+  const text = a.kids.exportFile();
+  assert.equal(JSON.parse(text).v, 1);
+  assert.deepEqual(b.kids.importFile(text), { added: 2, skipped: 0 });
+  assert.deepEqual(b.kids.list(), a.kids.list());
+  assert.equal(b.kids.list().find(k => k.id === x.id).look.colour, 'pink');
+  assert.deepEqual(b.kids.importFile(text), { added: 0, skipped: 0 }, 'again: nothing new');
+  for (const junk of ['', 'nope', '{}', '{"v":2,"kids":[]}', '[1]']) assert.throws(() => b.kids.importFile(junk), { code: 'bad_file' });
+  const odd = JSON.stringify({ v: 1, kids: [{ id: 'x1', name: 'a@b.c', avatar: 'cat' }, { id: 'x2', name: 'Fine' }, 7] });
+  assert.deepEqual(b.kids.importFile(odd), { added: 1, skipped: 2 }, 'a bad entry is skipped, the rest kept');
+});
+
+test('the merged list: grown-ups from the server, then the kids from the Box (marked)', () => {
+  const rows = server(['g1', 'Deep', 'A'], ['k1', 'Ellie', 'A'], ['g2', 'Sam', 'B'], ['k2', 'Ravi', 'B']);
+  const { grownups, kids } = splitProfiles(rows);
+  assert.deepEqual(grownups.map(p => p.id), ['g1', 'g2']);
+  assert.deepEqual(kids.map(p => p.id), ['k1', 'k2']);
+  const box = fresh().kids; box.importFromServer(kids);
+  const all = mergeProfiles(grownups, box.list());
+  assert.deepEqual(all.map(p => p.name), ['Deep', 'Sam', 'Ellie', 'Ravi']);
+  assert.deepEqual(all.map(p => !!p.kid), [false, false, true, true]);
+  assert.equal(splitProfiles(all).kids.length, 0, 'a merged list is not split again');
+});
+
+test('the account holds the merged list, and knows a kid when one is playing', () => {
+  const was = { state: account.state, toMove: account.toMove };
+  window.__TAURI_INTERNALS__ = { invoke: async () => null };      /* (Orlis Play) */
+  try {
+    account.state = { household: { id: 'h-merge' }, token: 't', server: { url: 'http://x' } };
+    const list = account.takeProfiles(server(['g1', 'Deep', 'A'], ['k1', 'Ellie', 'A']), { id: 'h-merge' });
+    assert.deepEqual(list.map(p => p.name), ['Deep', 'Ellie']);
+    assert.deepEqual(account.toMove, ['k1'], 'the server is to be told about it');
+    account.state = { ...account.state, profiles: list, current: 'k1' };
+    assert.equal(account.isKid, true);
+    account.state = { ...account.state, current: 'g1' };
+    assert.equal(account.isKid, false);
+    /* a kid added on the Box shows in the list */
+    const made = account.kids.add({ name: 'Mia' });
+    account.kidsChanged();
+    assert.deepEqual(account.state.profiles.map(p => p.name), ['Deep', 'Ellie', 'Mia']);
+    assert.equal(account.state.profiles[2].id, made.id);
+    account.kids.remove(made.id); account.kids.remove('k1'); account.kidsChanged();
+    assert.deepEqual(account.state.profiles.map(p => p.name), ['Deep']);
+  } finally { delete window.__TAURI_INTERNALS__; account.state = was.state; account.toMove = was.toMove; }
+});
+
+/* the one-time move, against a fake server */
+function fakeServer(rows, { failDelete = 0 } = {}){
+  const s = { rows: [...rows], log: [], failDelete, ownIds: new Set(rows.filter((r, i) => rows.findIndex(x => x.accountId === r.accountId) === i).map(r => r.id)) };
+  s.me = () => s.rows.map(r => ({ ...r }));
+  s.moved = async (ids) => {
+    s.log.push(['moved', [...ids]]);
+    if (s.failDelete > 0){ s.failDelete--; throw new Error('Couldn\'t reach the Orlis server.'); }
+    const gone = ids.filter(id => s.rows.some(r => r.id === id) && !s.ownIds.has(id));
+    s.rows = s.rows.filter(r => !gone.includes(r.id));
+    return { ids: gone };
+  };
+  return s;
+}
+const refresh = async (box, srv) => {
+  const { grownups, ids } = copyToBox(box, srv.me());
+  const copied = box.list().map(k => k.id);
+  const ok = await confirmMove(ids, (list) => { srv.log.push(['had', copied.length]); return srv.moved(list); });
+  return { grownups, ids, ok };
+};
+
+test('the move: copied to the Box before the server deletes anything', async () => {
+  const srv = fakeServer(server(['g1', 'Deep', 'A'], ['k1', 'Ellie', 'A'], ['k2', 'Ravi', 'A']));
+  const { kids: box } = fresh();
+  const r = await refresh(box, srv);
+  assert.equal(r.ok, true);
+  assert.deepEqual(srv.log[0], ['had', 2], 'both were in the Box when the server was asked');
+  assert.deepEqual(srv.log[1], ['moved', ['k1', 'k2']]);
+  assert.deepEqual(srv.rows.map(x => x.id), ['g1'], 'only the grown-up is left there');
+  assert.deepEqual(box.list().map(k => k.name), ['Ellie', 'Ravi']);
+});
+
+test('the move: a failed delete is tried again next refresh, and a second run does nothing', async () => {
+  const srv = fakeServer(server(['g1', 'Deep', 'A'], ['k1', 'Ellie', 'A']), { failDelete: 1 });
+  const { kids: box } = fresh();
+  assert.equal((await refresh(box, srv)).ok, false, 'could not be told');
+  assert.equal(srv.rows.length, 2, 'still on the server');
+  assert.deepEqual(box.list().map(k => k.name), ['Ellie'], 'but safely in the Box');
+  assert.equal((await refresh(box, srv)).ok, true, 'the next time');
+  assert.equal(box.list().length, 1, 'copied once');
+  assert.deepEqual(srv.rows.map(x => x.id), ['g1']);
+  const n = srv.log.length;
+  const third = await refresh(box, srv);
+  assert.equal(third.ok, true); assert.deepEqual(third.ids, []);
+  assert.equal(srv.log.length, n, 'nothing asked of the server the third time');
+});
+
+test('the move: nothing is deleted when the Box could not keep the copy', async () => {
+  const srv = fakeServer(server(['g1', 'Deep', 'A'], ['k1', 'Ellie', 'A']));
+  const { kids: box, st } = fresh();
+  st.broken = true;
+  const r = await refresh(box, srv);
+  assert.deepEqual(r.ids, []);
+  assert.equal(srv.log.length, 0, 'the server was not asked');
+  assert.equal(srv.rows.length, 2);
+});
+
+test('the move: an answer that is not an answer is a failure', async () => {
+  assert.equal(await confirmMove(['k1'], async () => ({})), false);
+  assert.equal(await confirmMove(['k1'], async () => { throw new Error('x'); }), false);
+  assert.equal(await confirmMove([], async () => { throw new Error('never called'); }), true);
+});
