new file mode 100644
index 0000000..2b372cc
--- /dev/null
+++ b/app/client/src-tauri/src/backups.rs
@@ -0,0 +1,139 @@
+//! The kids' profiles live on this PC (the Box), so a copy of them is kept as
+//! plain files in Documents\Orlis Play\Backups: one the parent asks for
+//! ("Save a backup"), and a quiet one after every change. The newest few are
+//! kept. The page hands over the text only (never a path); the files are
+//! named by this app.
+
+use std::{fs, path::{Path, PathBuf}, time::{SystemTime, UNIX_EPOCH}};
+use tauri::{AppHandle, Manager};
+
+/// How many backup files are kept.
+const KEEP: usize = 10;
+/// A backup is a small JSON file; anything bigger is not one.
+const MAX_BYTES: usize = 1_000_000;
+
+fn backups_dir(app: &AppHandle) -> Result<PathBuf, String> {
+    let docs = app.path().document_dir().map_err(|_| "Couldn't find the Documents folder.".to_string())?;
+    Ok(docs.join("Orlis Play").join("Backups"))
+}
+
+/// YYYY-MM-DD-HHMM for a time given as seconds since 1970 (UTC), so file names sort by time.
+fn stamp(secs: u64) -> String {
+    let days = (secs / 86_400) as i64;
+    let rem = secs % 86_400;
+    /* civil date from days since 1970-01-01 (Howard Hinnant's algorithm) */
+    let z = days + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z.rem_euclid(146_097);
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
+    format!("{y:04}-{m:02}-{d:02}-{:02}{:02}", rem / 3600, rem % 3600 / 60)
+}
+
+fn is_backup(name: &str) -> bool {
+    name.starts_with("kids-") && name.ends_with(".json")
+}
+
+/// The backup files in a folder, oldest first.
+fn files_in(dir: &Path) -> Vec<PathBuf> {
+    let mut v: Vec<PathBuf> = fs::read_dir(dir)
+        .map(|r| r.filter_map(|e| e.ok()).map(|e| e.path()).filter(|p| p.is_file() && p.file_name().and_then(|n| n.to_str()).map_or(false, is_backup)).collect())
+        .unwrap_or_default();
+    v.sort();
+    v
+}
+
+/// Write a backup into `dir` (made if need be), then keep only the `KEEP` newest. Returns its path.
+fn write_backup(dir: &Path, text: &str, secs: u64) -> Result<PathBuf, String> {
+    if text.len() > MAX_BYTES || serde_json::from_str::<serde_json::Value>(text).is_err() {
+        return Err("That isn't a backup.".into());
+    }
+    fs::create_dir_all(dir).map_err(|e| format!("Couldn't make the Backups folder: {e}"))?;
+    let path = dir.join(format!("kids-{}.json", stamp(secs)));
+    fs::write(&path, text).map_err(|e| format!("Couldn't save the backup: {e}"))?;
+    let all = files_in(dir);
+    for old in all.iter().take(all.len().saturating_sub(KEEP)) {
+        let _ = fs::remove_file(old);
+    }
+    Ok(path)
+}
+
+/// The newest backup's text, if there is one.
+fn newest(dir: &Path) -> Option<String> {
+    files_in(dir).pop().and_then(|p| fs::read_to_string(p).ok())
+}
+
+fn now() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)
+}
+
+/// Save the kids' backup (the text the page made); the path it went to.
+#[tauri::command]
+pub fn kids_backup(app: AppHandle, text: String) -> Result<String, String> {
+    let p = write_backup(&backups_dir(&app)?, &text, now())?;
+    Ok(p.to_string_lossy().into_owned())
+}
+
+/// The newest backup's text, to offer it back if the app's own copy is gone.
+#[tauri::command]
+pub fn kids_backup_latest(app: AppHandle) -> Option<String> {
+    newest(&backups_dir(&app).ok()?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn temp(name: &str) -> PathBuf {
+        let d = std::env::temp_dir().join(format!("orlis-backups-test-{}-{name}", std::process::id()));
+        let _ = fs::remove_dir_all(&d);
+        d
+    }
+
+    #[test]
+    fn the_stamp_is_a_sortable_date_and_time() {
+        assert_eq!(stamp(0), "1970-01-01-0000");
+        assert_eq!(stamp(1_795_323_196), "2026-11-22-0453");
+        assert_eq!(stamp(951_782_400 + 86_399), "2000-02-29-2359");
+        assert!(stamp(1_000_000_000) < stamp(1_000_000_060));
+    }
+
+    #[test]
+    fn a_backup_is_written_into_a_folder_made_for_it_and_read_back() {
+        let dir = temp("write").join("Orlis Play").join("Backups");
+        let p = write_backup(&dir, r#"{"v":1,"kids":[]}"#, 1_795_323_196).unwrap();
+        assert_eq!(p.file_name().unwrap().to_str().unwrap(), "kids-2026-11-22-0453.json");
+        assert_eq!(fs::read_to_string(&p).unwrap(), r#"{"v":1,"kids":[]}"#);
+        assert_eq!(newest(&dir).unwrap(), r#"{"v":1,"kids":[]}"#);
+        let _ = fs::remove_dir_all(dir.parent().unwrap().parent().unwrap());
+    }
+
+    #[test]
+    fn only_the_ten_newest_are_kept_and_other_files_are_left_alone() {
+        let dir = temp("prune");
+        fs::create_dir_all(&dir).unwrap();
+        fs::write(dir.join("notes.txt"), "mine").unwrap();
+        for i in 0..14u64 {
+            write_backup(&dir, &format!(r#"{{"v":1,"n":{i}}}"#), 1_795_000_000 + i * 600).unwrap();
+        }
+        let left = files_in(&dir);
+        assert_eq!(left.len(), KEEP);
+        assert!(left[0].to_str().unwrap().contains(&stamp(1_795_000_000 + 4 * 600)), "the oldest four went");
+        assert_eq!(newest(&dir).unwrap(), r#"{"v":1,"n":13}"#);
+        assert!(dir.join("notes.txt").exists(), "nothing else is touched");
+        let _ = fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn what_is_not_a_backup_is_refused_and_nothing_is_written() {
+        let dir = temp("refuse");
+        assert!(write_backup(&dir, "not json", 1).is_err());
+        assert!(write_backup(&dir, &format!("\"{}\"", "x".repeat(MAX_BYTES)), 1).is_err());
+        assert!(!dir.exists());
+        assert!(newest(&dir).is_none());
+    }
+}
