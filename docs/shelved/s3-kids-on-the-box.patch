diff --git a/app/test/kids-box.test.mjs b/app/test/kids-box.test.mjs
new file mode 100644
index 0000000..b6d9332
--- /dev/null
+++ b/app/test/kids-box.test.mjs
@@ -0,0 +1,103 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createKids, restoreOffer, autoBackup, saveBackup, isBoxApp } from '../src/ui/kids.js';
+import { account } from '../src/ui/account.js';
+
+const mem = () => { const m = new Map(); return { getItem: (k) => (m.has(k) ? m.get(k) : null), setItem: (k, v) => { m.set(k, String(v)); } }; };
+const fresh = () => createKids(mem(), { householdId: 'h1' });
+const server = (...rows) => rows.map(([id, name, accountId]) => ({ id, name, avatar: 'cat', look: null, accountId, createdAt: '2026-01-01T00:00:00.000Z' }));
+
+/* Orlis Play (Tauri) or not; the "app" records what it was asked to do */
+const asApp = (handlers = {}) => { const calls = []; window.__TAURI_INTERNALS__ = { invoke: async (cmd, args) => { calls.push([cmd, args]); return handlers[cmd] ? handlers[cmd](args) : null; } }; return calls; };
+const notApp = () => { delete window.__TAURI_INTERNALS__; };
+
+test('only Orlis Play moves the kids: a browser shows the server\'s kids, read-only, and nothing is copied or deleted', async () => {
+  notApp();
+  assert.equal(isBoxApp(), false);
+  const was = { state: account.state, toMove: account.toMove };
+  const realFetch = globalThis.fetch; let fetched = 0; globalThis.fetch = async () => { fetched++; throw new Error('no network in this test'); };
+  try {
+    account.state = { household: { id: 'h-web' }, token: 't', server: { url: 'http://x' } };
+    account.toMove = [];
+    const list = account.takeProfiles(server(['g1', 'Deep', 'A'], ['k1', 'Ellie', 'A']), { id: 'h-web' });
+    assert.deepEqual(list.map(p => p.name), ['Deep', 'Ellie'], 'they are still shown');
+    assert.equal(list[1].readOnly, true); assert.equal(list[1].kid, true); assert.ok(!list[0].readOnly);
+    assert.deepEqual(account.toMove, [], 'nothing to move');
+    assert.equal(localStorage.getItem('orlis.kids.h-web'), null, 'nothing written to this browser');
+    account.toMove = ['k1'];
+    await account.finishMove();
+    assert.equal(fetched, 0, 'the server is never asked to delete');
+    account.state = { ...account.state, profiles: list };
+    account.kidsChanged();
+    assert.deepEqual(account.state.profiles.map(p => p.name), ['Deep', 'Ellie'], 'still shown');
+  } finally { globalThis.fetch = realFetch; account.state = was.state; account.toMove = was.toMove; }
+});
+
+test('in Orlis Play the move runs: copied, backed up as a file, then the server is told', async () => {
+  const calls = asApp();
+  const was = { state: account.state, toMove: account.toMove };
+  const realFetch = globalThis.fetch; const asked = [];
+  globalThis.fetch = async (url, o) => { asked.push([url, JSON.parse(o.body)]); return { ok: true, json: async () => ({ ids: ['k1'] }) }; };
+  try {
+    account.state = { household: { id: 'h-app' }, token: 't', server: { url: 'http://x' } };
+    account.toMove = [];
+    account.state.profiles = account.takeProfiles(server(['g1', 'Deep', 'A'], ['k1', 'Ellie', 'A']), { id: 'h-app' });
+    assert.deepEqual(account.state.profiles.map(p => p.name), ['Deep', 'Ellie']);
+    assert.ok(!account.state.profiles[1].readOnly);
+    await account.finishMove();
+    assert.equal(calls[0][0], 'kids_backup', 'the file first');
+    assert.equal(JSON.parse(calls[0][1].text).kids[0].name, 'Ellie');
+    assert.deepEqual(asked, [['http://x/api/profiles/moved', { ids: ['k1'] }]]);
+    assert.deepEqual(account.toMove, []);
+  } finally { notApp(); globalThis.fetch = realFetch; account.state = was.state; account.toMove = was.toMove; }
+});
+
+test('a safety copy after a change; Save a backup in the app writes the file (no download)', async () => {
+  const kids = fresh();
+  kids.add({ name: 'Ollie' });
+  notApp();
+  assert.equal(await autoBackup(kids), false, 'a browser keeps no files');
+  const calls = asApp();
+  assert.equal(await autoBackup(kids), true);
+  assert.equal(calls[0][0], 'kids_backup'); assert.equal(JSON.parse(calls[0][1].text).kids.length, 1);
+  assert.match(await saveBackup(kids.exportFile()), /Documents .* Orlis Play .* Backups/);
+  assert.equal(calls.length, 2);
+  asApp({ kids_backup: () => { throw new Error('disk full'); } });
+  assert.equal(await autoBackup(kids), false, 'a failed quiet copy never gets in the way');
+  notApp();
+});
+
+test('on start: an empty store with a backup file offers it back; otherwise nothing', async () => {
+  const a = fresh(), b = fresh();
+  a.add({ name: 'Ollie' }); a.add({ name: 'Mia' });
+  const file = a.exportFile();
+  notApp();
+  assert.equal(await restoreOffer(b, async () => file), null, 'only in Orlis Play');
+  asApp();
+  const offer = await restoreOffer(b, async () => file);
+  assert.equal(offer.count, 2); assert.equal(offer.text, file);
+  assert.deepEqual(b.list(), [], 'offering changes nothing');
+  assert.equal(await restoreOffer(b, async () => null), null, 'no file');
+  assert.equal(await restoreOffer(b, async () => 'junk'), null, 'not a backup');
+  assert.equal(await restoreOffer(b, async () => JSON.stringify({ v: 1, kids: [] })), null, 'nobody in it');
+  assert.equal(await restoreOffer(b, async () => { throw new Error('x'); }), null);
+  b.importFile(file);
+  assert.equal(await restoreOffer(b, async () => file), null, 'the store is not empty: no offer');
+  notApp();
+});
+
+test('saying yes brings them back through the account', async () => {
+  const was = { state: account.state, offered: account.offered };
+  const a = fresh(); a.add({ name: 'Ollie' });
+  asApp({ kids_backup_latest: () => a.exportFile() });
+  try {
+    account.state = { household: { id: 'h-restore' }, token: 't', server: { url: 'http://x' }, profiles: [{ id: 'g1', name: 'Deep', accountId: 'A' }] };
+    account.offered = false;
+    assert.equal(createKids(localStorage, { householdId: 'h-restore' }).list().length, 0);
+    /* (the question itself is a popup; the test answers it) */
+    const offer = await restoreOffer(account.kids);
+    assert.equal(offer.count, 1);
+    account.kids.importFile(offer.text); account.kidsChanged();
+    assert.deepEqual(account.state.profiles.map(p => p.name), ['Deep', 'Ollie']);
+  } finally { notApp(); account.state = was.state; account.offered = was.offered; }
+});
