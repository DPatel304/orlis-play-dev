diff --git a/server/test/kids-helper.mjs b/server/test/kids-helper.mjs
new file mode 100644
index 0000000..7eb3011
--- /dev/null
+++ b/server/test/kids-helper.mjs
@@ -0,0 +1,11 @@
+import { newId } from '../src/secure.js';
+
+/* Kids' profiles live on the Box now, so the server no longer makes them.
+   A test that needs one the way an old server would have it (a second
+   profile on an account) puts it straight in the database. Returns its id. */
+export function addKid(db, accountId, name, { avatar = 'rocket', look = null } = {}){
+  const id = newId();
+  db.prepare('INSERT INTO profiles (id, account_id, name, avatar, look, created_at) VALUES (?, ?, ?, ?, ?, ?)')
+    .run(id, accountId, name, avatar, look && JSON.stringify(look), new Date().toISOString());
+  return id;
+}
diff --git a/server/test/kids-move.test.mjs b/server/test/kids-move.test.mjs
new file mode 100644
index 0000000..3a2b7f2
--- /dev/null
+++ b/server/test/kids-move.test.mjs
@@ -0,0 +1,95 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { start } from '../src/app.js';
+import { history } from '../src/history.js';
+import { addKid } from './kids-helper.mjs';
+
+async function fresh(){
+  const dataDir = mkdtempSync(join(tmpdir(), 'orlis-kids-'));
+  const s = await start({ everyoneCreates: false, dataDir, port: 0, discoveryPort: 0, name: 'Test Orlis' });
+  const call = async (method, path, body, token, manage = false) => {
+    const r = await fetch(`http://127.0.0.1:${s.port}${path}`, {
+      method, headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}), ...(manage ? { 'X-Orlis-Manage': s.manageKey } : {}) },
+      body: body ? JSON.stringify(body) : undefined
+    });
+    return { status: r.status, ...(await r.json()) };
+  };
+  return { s, call };
+}
+const grownUp = (email, extra = {}) => ({ email, password: 'correct horse', name: 'Sam', adult: true, device: 'Laptop', ...extra });
+const count = (db) => db.prepare('SELECT COUNT(*) AS n FROM profiles').get().n;
+
+async function twoFamilies(){
+  const { s, call } = await fresh();
+  const me = await call('POST', '/api/signup', grownUp('a@example.com', { name: 'Deep', family: 'The Patels' }));
+  const partner = await call('POST', '/api/signup', grownUp('p@example.com', { name: 'Pat', invite: (await call('POST', '/api/invites', {}, me.token)).code }));
+  const friend = await call('POST', '/api/signup', grownUp('f@example.com', { name: 'Max', invite: (await call('POST', '/api/invites', { household: 'new' }, me.token)).code }));
+  return { s, call, me, partner, friend };
+}
+
+test('moved: deletes the family\'s kids, and only them', async () => {
+  const { s, call, me, partner, friend } = await twoFamilies();
+  try {
+    const ellie = addKid(s.db, me.account.id, 'Ellie'), ravi = addKid(s.db, partner.account.id, 'Ravi');
+    const theirs = addKid(s.db, friend.account.id, 'Zed');
+    const r = await call('POST', '/api/profiles/moved', { ids: [ellie, ravi] }, me.token);
+    assert.equal(r.status, 200);
+    assert.deepEqual([...r.ids].sort(), [ellie, ravi].sort());
+    assert.deepEqual((await call('GET', '/api/me', null, me.token)).profiles.map(p => p.name).sort(), ['Deep', 'Pat']);
+    assert.ok(s.db.prepare('SELECT 1 FROM profiles WHERE id = ?').get(theirs), 'another family\'s kid is still there');
+    assert.deepEqual((await call('POST', '/api/profiles/moved', { ids: [ellie] }, me.token)).ids, [], 'a second time does nothing');
+  } finally { await s.close(); }
+});
+
+test('moved: never a grown-up\'s own profile, never another family\'s', async () => {
+  const { s, call, me, partner, friend } = await twoFamilies();
+  try {
+    const kid = addKid(s.db, friend.account.id, 'Zed');
+    const before = count(s.db);
+    const ids = [me.profiles[0].id, partner.profiles.find(p => p.accountId === partner.account.id).id, kid, 'nope', 7, null];
+    const r = await call('POST', '/api/profiles/moved', { ids }, me.token);
+    assert.deepEqual(r.ids, []);
+    assert.equal(count(s.db), before, 'nothing deleted');
+    assert.equal((await call('POST', '/api/profiles/moved', {}, me.token)).status, 200, 'no ids: nothing');
+    assert.equal((await call('POST', '/api/profiles/moved', { ids: [kid] }, null)).status, 401, 'signed in only');
+    assert.equal(count(s.db), before);
+  } finally { await s.close(); }
+});
+
+test('a kid cannot be made, changed or removed on the server: 410', async () => {
+  const { s, call } = await fresh();
+  try {
+    const me = await call('POST', '/api/signup', grownUp('a@example.com'));
+    const kid = addKid(s.db, me.account.id, 'Ollie');
+    const made = await call('POST', '/api/profiles', { name: 'New' }, me.token);
+    assert.equal(made.status, 410); assert.equal(made.error, 'moved'); assert.match(made.message, /Orlis Play PC/);
+    assert.equal((await call('PATCH', `/api/profiles/${kid}`, { name: 'X' }, me.token)).status, 410);
+    assert.equal((await call('DELETE', `/api/profiles/${kid}`, null, me.token)).status, 410);
+    assert.equal(count(s.db), 2);
+    assert.equal((await call('PATCH', `/api/profiles/${me.profiles[0].id}`, { name: 'Deep' }, me.token)).name, 'Deep', 'the grown-up\'s own still changes');
+  } finally { await s.close(); }
+});
+
+test('the History entry counts kids and names none; the management page counts those waiting', async () => {
+  const { s, call, me, friend } = await twoFamilies();
+  try {
+    const a = addKid(s.db, me.account.id, 'Ellie'), b = addKid(s.db, me.account.id, 'Bartholomew');
+    addKid(s.db, friend.account.id, 'Zed');
+    const fams = async () => Object.fromEntries((await call('GET', '/api/households', null, null, true)).households.map(h => [h.name, h]));
+    let f = await fams();
+    assert.equal(f['The Patels'].kidsWaiting, 2); assert.equal(f["Max's family"].kidsWaiting, 1);
+    assert.equal(f['The Patels'].profiles, 4, 'two grown-ups and two kids');
+    await call('POST', '/api/profiles/moved', { ids: [a, b] }, me.token);
+    f = await fams();
+    assert.equal(f['The Patels'].kidsWaiting, 0); assert.equal(f["Max's family"].kidsWaiting, 1, 'the other family still waits');
+    const log = history(s.db).list().filter(e => e.what === 'kids-moved');
+    assert.equal(log.length, 1);
+    assert.equal(log[0].note, "moved 2 kids' profiles to the Box");
+    assert.ok(!JSON.stringify(history(s.db).list()).match(/Ellie|Bartholomew|Zed/), 'no kid names in History');
+    await call('POST', '/api/profiles/moved', { ids: [a] }, me.token);
+    assert.equal(history(s.db).list().filter(e => e.what === 'kids-moved').length, 1, 'nothing moved, nothing logged');
+  } finally { await s.close(); }
+});
