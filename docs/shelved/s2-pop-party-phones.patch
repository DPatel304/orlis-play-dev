diff --git a/app/src/ui/join-chip.js b/app/src/ui/join-chip.js
new file mode 100644
index 0000000..3bcbb70
--- /dev/null
+++ b/app/src/ui/join-chip.js
@@ -0,0 +1,38 @@
+/* The join chip (plan package S2): for a game where phones are optional (`seats.pads[0] === 0`, like Pop Party) there is no join card before the round;
+   the round starts as it always did and phones drop in at any time. This is how a phone finds the game: the QR and the three pictures, small in the
+   bottom-right corner while playing (`joinChip({ rt })`), and larger on the pause screen (`joinChip({ rt, big: true })`). It hides itself once every
+   pad seat is taken, and comes back if a seat frees up. It never takes a tap (pointer-events none).                                                  */
+import { h } from './screens.js';
+import { assets } from '../games/assets/index.js';
+import { qrMatrix, drawQR } from '../session/qr.js';
+
+const vh = () => (typeof innerHeight === 'number' ? innerHeight : 720);
+const dpr = () => Math.min(2, (typeof devicePixelRatio === 'number' && devicePixelRatio) || 1);
+
+export function joinChip({ rt, big = false }) {
+  const el = h('div', 'joinchip' + (big ? ' big' : ''));
+  el.dataset.kind = big ? 'pause' : 'corner';
+  const side = Math.round(vh() * (big ? 0.18 : 0.15) * dpr());     /* the corner chip is about 15% of the screen height */
+  const qrBox = h('div', 'jcqr'), qc = document.createElement('canvas');
+  qc.width = qc.height = side;
+  const url = rt.padUrl;
+  if (url) { try { drawQR(qc.getContext('2d'), qrMatrix(url), 0, 0, side); } catch { /* the pictures still work from the pad page */ } }
+  qc.dataset.url = url || '';
+  qrBox.appendChild(qc);
+  const pics = h('div', 'jcpics');
+  for (const id of rt.session.join.pictures) {
+    const cv = document.createElement('canvas'); cv.width = cv.height = Math.round(side / 2.2); cv.dataset.id = id;
+    const c = cv.getContext('2d');
+    if (c) { try { assets.draw(c, id, cv.width / 2, cv.height / 2, cv.width * 0.8); } catch { /* a blank card */ } }
+    pics.appendChild(cv);
+  }
+  el.append(qrBox, pics);
+  let seen = false, off = null;
+  const sync = () => {
+    if (el.isConnected) seen = true; else if (seen) { if (off) off(); off = null; return; }      /* (taken away with its screen: stop listening) */
+    el.classList.toggle('hide', rt.full);
+  };
+  off = rt.session.on('change', sync);
+  sync();
+  return { el, sync, remove() { if (off) off(); off = null; el.remove(); } };
+}
