+  assert.equal(seat.length, 1);
+  r.advance(9000); assert.deepEqual(r.rt.activeSeats(10), seat);
+  r.advance(2000); assert.deepEqual(r.rt.activeSeats(10), [], 'quiet for over 10 s');
+  assert.deepEqual(r.rt.activeSeats(Infinity), seat, 'but it did play (the scores count it)');
+  assert.equal(r.rt.full, false, 'one of two seats');
+  r.joinPhone('c2', 'mia');
+  assert.equal(r.rt.full, true, 'both seats taken: the corner chip hides');
+  assert.equal(rig(LAB).rt.full, false);
+});
diff --git a/app/test/pop-party-pads.test.mjs b/app/test/pop-party-pads.test.mjs
new file mode 100644
index 0000000..5a8211a
--- /dev/null
+++ b/app/test/pop-party-pads.test.mjs
@@ -0,0 +1,138 @@
+/* Pop Party with phones (plan package S2): a pad player is a mitt that follows a finger and pops like a hand. A fake pads object stands in for the shell's. */
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import popParty, { PAD_BASE } from '../src/games/pop-party.js';
+import { usesPads } from '../src/session/pads.js';
+import { pose } from '../src/tracking/pose.js';
+
+function fakePads(seats = [{ n: 1, kind: 'pad', who: 'sam', name: 'Sam', avatar: null, colour: 'orange', state: 'live' }]) {
+  const subs = {}, sent = [];
+  return { subs, sent, seats,
+    on(name, fn) { (subs[name] ||= []).push(fn); return () => { subs[name] = subs[name].filter(f => f !== fn); }; },
+    send(to, m) { sent.push({ to, m }); }, state() {},
+    emit(name, e) { (subs[name] || []).slice().forEach(f => f(e)); },
+    join(s = seats[0]) { this.emit('join', { seat: s.n, who: s.who, name: s.name, avatar: s.avatar, colour: s.colour }); },
+    input(seat, m) { this.emit('input', { seat, who: 'x', m }); } };
+}
+function nobody() { pose.mouse.active = false; for (const p of pose.players) p.present = false; }
+function parked(inst, x, y, r = 0.065) {
+  const b = inst._make(x);
+  Object.assign(b, { by: y, rise: 0, r, worth: 1, kind: 'normal', motion: 'drift', dir: 0, f: 0, ph: 0 });
+  return b;
+}
+function mk(pads) { const i = popParty.create(1, { pads }); i.spawn = 1e9; i.events = []; return i; }
+const run = (inst, secs, dt = 1 / 60) => { for (let t = 0; t < secs; t += dt) inst.step(dt, 1280, 720); };
+
+test('the manifest: 1 to 4 tracked, 0 to 4 phones, with a pad program; without phones it still plays', () => {
+  assert.deepEqual(popParty.seats, { tracked: [1, 4], pads: [0, 4] });
+  assert.deepEqual(popParty.pads, { program: '/pads/pop-party/', need: 'controller' });
+  assert.equal(usesPads(popParty), true);
+  assert.equal(popParty.requiredPads, undefined, 'no phone is needed');
+  const inst = popParty.create(1);                       /* no env: exactly the old way */
+  assert.equal(inst.mitts.size, 0);
+  assert.doesNotThrow(() => { nobody(); run(inst, 1); });
+});
+
+test('a finger drags a mitt toward it; a fresh touch starts at the finger', () => {
+  nobody();
+  const pads = fakePads(), inst = mk(pads);
+  pads.join();
+  assert.equal(inst.mitts.size, 1);
+  const m = inst.mitts.get(1);
+  assert.equal(m.idx, PAD_BASE); assert.equal(m.down, false);
+  pads.input(1, { x: 0.2, y: 0.3 });
+  assert.equal(m.down, true); assert.equal(m.x, 0.2); assert.equal(m.y, 0.3, 'first touch lands on the finger');
+  pads.input(1, { x: 0.8, y: 0.6 });
+  run(inst, 1 / 30);
+  assert.ok(m.x > 0.2 && m.x < 0.8, 'moves smoothly, not a jump: ' + m.x);
+  run(inst, 1);
+  assert.ok(Math.abs(m.x - 0.8) < 0.01 && Math.abs(m.y - 0.6) < 0.01, 'arrives');
+  pads.input(1, { x: 5, y: -3 });
+  assert.equal(m.tx, 1); assert.equal(m.ty, 0, 'kept on the screen');
+  pads.input(1, { x: 'a', y: null }); assert.equal(m.tx, 1, 'junk is ignored');
+});
+
+test('a mitt pops a balloon like a hand: same score, counts for that player, and the phone is told', () => {
+  nobody();
+  const pads = fakePads(), inst = mk(pads);
+  pads.join();
+  inst.balloons = [parked(inst, 0.5, 0.5)];
+  pads.input(1, { x: 0.5, y: 0.5 });
+  run(inst, 0.1);
+  assert.equal(inst.balloons.length, 0, 'popped');
+  assert.equal(inst.score[PAD_BASE], 1);
+  assert.equal(inst.popped[PAD_BASE].length, 1);
+  assert.deepEqual(pads.sent.map(s => [s.to, s.m.e]), [[1, 'pop']]);
+  assert.equal(inst.score[0], 0, 'not the camera player');
+  const rows = inst.tally();
+  assert.deepEqual(rows.map(r => [r.label, r.value]), [['Sam', 1]]);
+  assert.equal(inst.value(), 1);
+  assert.equal(inst.winner(), null, 'one player: no winner');
+});
+
+test('a lifted finger: the mitt fades and pops nothing until touched again', () => {
+  nobody();
+  const pads = fakePads(), inst = mk(pads);
+  pads.join();
+  pads.input(1, { x: 0.3, y: 0.3 }); run(inst, 0.5);
+  const m = inst.mitts.get(1);
+  assert.equal(m.a, 1);
+  pads.input(1, { up: true });
+  inst.balloons = [parked(inst, 0.3, 0.3)];
+  run(inst, 0.5);
+  assert.equal(inst.balloons.length, 1, 'a lifted mitt does not pop');
+  assert.equal(m.a, 0, 'faded out');
+  pads.input(1, { x: 0.3, y: 0.3 }); run(inst, 0.1);
+  assert.equal(inst.balloons.length, 0, 'touching again pops');
+});
+
+test('a dropped phone stops popping; its score stays; coming back works', () => {
+  nobody();
+  const pads = fakePads(), inst = mk(pads);
+  pads.join(); pads.input(1, { x: 0.5, y: 0.5 }); inst.balloons = [parked(inst, 0.5, 0.5)]; run(inst, 0.1);
+  assert.equal(inst.score[PAD_BASE], 1);
+  pads.emit('leave', { seat: 1 });
+  assert.equal(inst.mitts.get(1).down, false);
+  inst.balloons = [parked(inst, 0.5, 0.5)]; run(inst, 0.2);
+  assert.equal(inst.balloons.length, 1);
+  pads.join(); assert.equal(inst.mitts.size, 1, 'the same player, not a second one');
+  pads.input(1, { x: 0.5, y: 0.5 }); run(inst, 0.1);
+  assert.equal(inst.score[PAD_BASE], 2);
+});
+
+test('two phones and a camera hand play together, each scored apart; the giant takes a slap from a mitt per touch', () => {
+  const seats = [{ n: 1, kind: 'pad', who: 'sam', name: 'Sam', colour: 'orange' }, { n: 2, kind: 'pad', who: 'mia', name: 'Mia', colour: 'pink' }];
+  const pads = fakePads(seats), inst = mk(pads);
+  nobody();
+  const p = pose.players[0]; p.present = true;
+  p.hands.left = { x: 0.2, y: 0.5, vx: 0, vy: 0, speed: 0 }; p.hands.right = { x: -1, y: -1, vx: 0, vy: 0, speed: 0 };
+  seats.forEach(s => pads.join(s));
+  inst.balloons = [parked(inst, 0.2, 0.5), parked(inst, 0.5, 0.5), parked(inst, 0.8, 0.5)];
+  pads.input(1, { x: 0.5, y: 0.5 }); pads.input(2, { x: 0.8, y: 0.5 });
+  run(inst, 0.1);
+  assert.equal(inst.balloons.length, 0);
+  assert.deepEqual([inst.score[0], inst.score[PAD_BASE], inst.score[PAD_BASE + 1]], [1, 1, 1]);
+  assert.deepEqual(inst.tally().map(r => r.label), ['Player 1', 'Sam', 'Mia']);
+  assert.deepEqual(pads.sent.map(s => s.to).sort(), [1, 2], 'each phone told about its own pop only');
+  /* the giant: one slap per touch from a mitt resting on it */
+  nobody();
+  const g = inst._giant(); g.by = 0.5; g.rise = 0; g.motion = 'drift'; g.dir = 0; g.f = 0; g.ph = 0; g.x0 = 0.5; g.by = 0.5; inst.balloons = [g];
+  pads.input(1, { up: true }); pads.input(2, { up: true });
+  pads.input(1, { x: 0.5, y: 0.5 }); run(inst, 0.5);
+  assert.equal(g.slaps, 1, 'resting counts once');
+  pads.input(1, { up: true }); pads.input(1, { x: 0.5, y: 0.5 }); run(inst, 0.3);
+  assert.equal(g.slaps, 2, 'a new touch is a new slap');
+});
+
+test('the round report and the bouquets count a phone player; drawing mitts, faces and bouquets does not throw', () => {
+  nobody();
+  const pads = fakePads(), inst = mk(pads);
+  pads.join(); pads.input(1, { x: 0.5, y: 0.5 });
+  const calls = [];
+  const c = new Proxy({}, { get: (t, k) => k in t ? t[k] : (k === 'createRadialGradient' || k === 'createLinearGradient' ? () => ({ addColorStop() {} }) : (...a) => { calls.push(k); }), set: (t, k, v) => { t[k] = v; return true; } });
+  assert.doesNotThrow(() => { run(inst, 0.5); inst._drawPadMitts(c, 1280, 720); });
+  assert.ok(calls.includes('arc'), 'the mitt is drawn');
+  inst._startOutro();
+  assert.deepEqual(inst.out.groups.map(g => g.who), [PAD_BASE], 'a bunch for the phone player');
+  assert.doesNotThrow(() => { inst.outro(0.1, 1280, 720); inst._drawBouquets(c, 1280, 720); });
+});
