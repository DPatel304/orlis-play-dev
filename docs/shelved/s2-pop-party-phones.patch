@@ -0,0 +1,53 @@
+/* The owner's pictures for Pop Party with phones (plan package S2) into docs/s2/, at device scale 2, from the real shell:
+     tv.png          the TV: one tracked hand (the mouse stands in for the camera), two phone mitts with their faces, and the corner join chip
+     pause.png       the pause screen with the larger QR and pictures
+     phone.png       a phone held sideways with a finger down (the pad in the player's colour)
+     phone-idle.png  the same phone before it is touched: the one hint
+   Run:  cd app && node test/preview/s2-shots.mjs */
+import path from 'node:path';
+import fs from 'node:fs';
+import { startRig, joinPhone, until, ANDROID, PHONE, APP } from '../harness/pads-rig.mjs';
+
+const OUT = path.join(APP, '..', 'docs', 's2');
+fs.mkdirSync(OUT, { recursive: true });
+const SIDEWAYS = (o) => ({ ...o, viewport: { width: 844, height: 390 } });
+const rig = await startRig({ tvSize: { width: 1280, height: 720 } });
+try {
+  const tv = await rig.tv('pop-party', { scale: 2 });
+  /* no join card: the line-up (three profiles) and the round starts */
+  for (let t0 = Date.now(); !(await tv.page.evaluate(() => !!(window.__round && window.__round() && !document.querySelector('.screen.lineup')))); ) {
+    const go = tv.page.locator('.screen.lineup .btn.go'); if (await go.count()) await go.click().catch(() => {});
+    if (Date.now() - t0 > 20000) throw new Error('no round');
+    await new Promise(r => setTimeout(r, 100));
+  }
+  await tv.page.locator('.joinchip[data-kind="corner"]').waitFor();
+  const sam = await rig.phone(SIDEWAYS(PHONE)), mia = await rig.phone(SIDEWAYS(ANDROID));
+  await joinPhone(rig, tv, sam, 'sam');
+  await joinPhone(rig, tv, mia, 'mia');
+  await sam.page.waitForFunction(() => document.body.dataset.program === 'on');
+  await sam.page.waitForTimeout(500);
+  await sam.page.screenshot({ path: path.join(OUT, 'phone-idle.png') });
+  await until(() => tv.page.evaluate(() => window.__round().mitts.size === 2), 5000, 'two mitts');
+  /* a calm moment: no animals, a few balloons spread over the sky, the opening line gone */
+  await tv.page.evaluate(() => {
+    const r = window.__round(); r.events = []; r.t = 12; r.spawn = 1e9; r.balloons = [];
+    [[0.12, 0.55], [0.3, 0.3], [0.45, 0.62], [0.62, 0.28], [0.74, 0.58], [0.9, 0.35], [0.2, 0.8], [0.55, 0.85]].forEach(([x, y], k) => {
+      const b = r._make(x); Object.assign(b, { by: y, rise: 0, r: 0.045 + (k % 3) * 0.015, kind: 'normal', motion: 'drift', dir: 0, f: 0, ph: k }); r.balloons.push(b);
+    });
+  });
+  const at = (p, fx, fy) => p.page.evaluate(() => 0).then(async () => { const b = await p.page.locator('.padroot').boundingBox(); await p.page.mouse.move(b.x + b.width * fx, b.y + b.height * fy); });
+  /* the tracked hand (the mouse) at the left, Sam on the middle left, Mia on the right; none touches a balloon */
+  await tv.page.mouse.move(1280 * 0.38, 720 * 0.45);
+  await at(sam, 0.52, 0.6); await sam.page.mouse.down(); await at(sam, 0.5, 0.55);
+  await at(mia, 0.8, 0.45); await mia.page.mouse.down(); await at(mia, 0.78, 0.47);
+  await tv.page.waitForTimeout(1200);
+  await tv.page.screenshot({ path: path.join(OUT, 'tv.png') });
+  await sam.page.screenshot({ path: path.join(OUT, 'phone.png') });
+  await tv.page.keyboard.press('Escape');
+  await tv.page.locator('.joinchip[data-kind="pause"]').waitFor();
+  await tv.page.waitForTimeout(900);
+  await tv.page.screenshot({ path: path.join(OUT, 'pause.png') });
+  console.log('pictures in', OUT);
+} finally {
+  await rig.close();
+}
