+/* The pad program for Pop Party (plan package S2): the whole phone screen is a touch pad in the player's colour.
+   Where the finger is (x and y, 0 to 1, left to right and top to bottom; the phone held sideways has the TV's shape) goes to the TV about
+   30 times a second while it touches, and { up: true } when it lifts. The TV moves that player's mitt there and pops balloons with it.
+   When the TV says { e: 'pop' } (this player popped something) the pad gives a small pop: a ring where the finger is, and a buzz if it can. */
+export default function start(api) {
+  const root = api.root, colour = api.colour || '#3da9ff';
+  root.style.cssText = `position:absolute;inset:0;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none;background:${colour}`;
+  root.innerHTML = '';
+
+  const hint = document.createElement('div');
+  hint.className = 'popHint';
+  hint.textContent = 'Drag to move your mitt';
+  hint.style.cssText = 'position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);text-align:center;font:800 clamp(22px,6vmin,40px)/1.2 system-ui,sans-serif;color:#fff;text-shadow:0 2px 0 rgba(47,43,69,.35);padding:0 24px;pointer-events:none;transition:opacity .25s';
+  const finger = document.createElement('div');
+  finger.className = 'popFinger';
+  const F = Math.max(70, Math.min(window.innerWidth, window.innerHeight) * 0.2);
+  finger.style.cssText = `position:absolute;left:0;top:0;width:${F}px;height:${F}px;margin:${-F / 2}px 0 0 ${-F / 2}px;border-radius:50%;background:#fff;border:6px solid #2f2b45;box-shadow:0 0 0 ${F * 0.25}px rgba(255,255,255,.35);opacity:0;transition:opacity .12s;pointer-events:none`;
+  root.append(hint, finger);
+
+  let held = false, x = 0.5, y = 0.5, lastSent = '', lastAt = 0, timer = 0;
+  const clamp = (v) => Math.max(0, Math.min(1, v));
+  const r2 = (v) => Math.round(v * 1000) / 1000;
+  function post(force) {
+    const k = r2(x) + ',' + r2(y), now = Date.now();
+    if (!force && k === lastSent && now - lastAt < 100) return;
+    lastSent = k; lastAt = now;
+    api.send({ x: r2(x), y: r2(y) });
+  }
+  function at(e) {
+    const b = root.getBoundingClientRect();
+    x = clamp((e.clientX - b.left) / b.width); y = clamp((e.clientY - b.top) / b.height);
+    finger.style.transform = `translate(${x * b.width}px,${y * b.height}px)`;
+  }
+  root.addEventListener('pointerdown', (e) => {
+    held = true; try { root.setPointerCapture(e.pointerId); } catch { /* fine */ }
+    at(e); finger.style.opacity = '1'; hint.style.opacity = '0';
+    post(true); clearInterval(timer); timer = setInterval(() => { if (held) post(false); }, 33);   /* about 30 a second */
+  });
+  root.addEventListener('pointermove', (e) => { if (held) at(e); });
+  const up = () => {
+    if (!held) return;
+    held = false; clearInterval(timer); finger.style.opacity = '0'; hint.style.opacity = '1';
+    lastSent = ''; api.send({ up: true });
+  };
+  root.addEventListener('pointerup', up); root.addEventListener('pointercancel', up);
+
+  /* a small pop: a ring where the finger is */
+  function pop() {
+    const ring = document.createElement('div');
+    ring.className = 'popRing';
+    const b = root.getBoundingClientRect();
+    ring.style.cssText = `position:absolute;left:${x * b.width}px;top:${y * b.height}px;width:${F}px;height:${F}px;margin:${-F / 2}px 0 0 ${-F / 2}px;border-radius:50%;border:8px solid #fff;pointer-events:none;opacity:.9;transform:scale(.6);transition:transform .35s ease-out,opacity .35s ease-out`;
+    root.appendChild(ring);
+    requestAnimationFrame(() => requestAnimationFrame(() => { ring.style.transform = 'scale(2.2)'; ring.style.opacity = '0'; }));
+    setTimeout(() => ring.remove(), 450);
+    try { if (navigator.vibrate) navigator.vibrate(25); } catch { /* fine */ }
+  }
+  if (api.onEvent) api.onEvent((ev) => { if (ev && ev.e === 'pop') pop(); });
+  return { stop() { clearInterval(timer); } };
+}
